    "triangle_add_point_power_flip_horizontal": {
      "params": {
        "init": "triangle",
        "resolution": 512,
        "ops": [
          {
            "op": "add_point",
            "index": 1,
            "x": 0.25,
            "y": 0.8
          },
          {
            "op": "set_power",
            "index": 0,
            "power": 2.5
          },
          {
            "op": "set_power",
            "index": 2,
            "power": -4.0
          },
          {
            "op": "flip_horizontal"
          }
        ],
        "saved_json": false
      }
    },
    "square_middle_remove_flip_vertical": {
      "params": {
        "init": "square",
        "resolution": 512,
        "ops": [
          {
            "op": "add_middle_point",
            "index": 1
          },
          {
            "op": "remove_point",
            "index": 3
          },
          {
            "op": "flip_vertical"
          }
        ]
      }
    },
    "sin_smooth_loop_flip_horizontal": {
      "params": {
        "init": "sin",
        "resolution": 1024,
        "ops": [
          {
            "op": "set_smooth",
            "value": true
          },
          {
            "op": "set_loop",
            "value": true
          },
          {
            "op": "flip_horizontal"
          }
        ],
        "saved_json": false
      }
    },
    "saw_up_set_point_num_points": {
      "params": {
        "init": "saw_up",
        "resolution": 300,
        "ops": [
          {
            "op": "set_point",
            "index": 0,
            "x": 0.0,
            "y": 0.3
          },
          {
            "op": "add_point",
            "index": 1,
            "x": 0.6,
            "y": 0.1
          },
          {
            "op": "set_num_points",
            "count": 2
          }
        ]
      }
    },
    "linear_many_middle_points": {
      "params": {
        "init": "linear",
        "resolution": 2048,
        "ops": [
          {
            "op": "add_middle_point",
            "index": 1
          },
          {
            "op": "add_middle_point",
            "index": 1
          },
          {
            "op": "add_middle_point",
            "index": 3
          },
          {
            "op": "set_power",
            "index": 1,
            "power": -3.0
          },
          {
            "op": "set_point",
            "index": 2,
            "x": 0.5,
            "y": 0.9
          },
          {
            "op": "flip_vertical"
          },
          {
            "op": "set_loop",
            "value": true
          }
        ]
