            "x": 0.4,
            "y": 0.2
          },
          {
            "op": "set_power",
            "index": 1,
            "power": 1.5
          },
          {
            "op": "remove_point",
            "index": 0
          },
          {
            "op": "flip_horizontal"
          },
          {
            "op": "set_smooth",
            "value": true
          }
        ],
