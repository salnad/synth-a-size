{
  "description": "Digital state-variable filter (SynthFilter model \"digital\").",
  "module": "filter",
  "params": {
    "model": "digital"
  },
  "cases": {
    "lowpass_saw_sweep": {
      "sample_rate": 44100,
      "block_size": 64,
      "num_samples": 22050,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "reset": {
          "trigger": [
            {
              "sample": 0,
              "value": "voice_on"
            }
          ]
        },
        "midi_cutoff": {
          "signal": "ramp",
          "from": 30.0,
          "to": 110.0
        },
        "resonance": 0.7,
        "drive_gain": 0.0,
        "style": 0,
        "pass_blend": 0.0
      }
    }
  }
}
