{
  "description": "DigitalSvf with the per-instance settings of the equalizer (setBasic, setDriveCompensation) and the formant manager (setResonanceBounds).",
  "module": "digital_svf",
  "params": {},
  "cases": {
    "eq_highpass": {
      "num_samples": 22050,
      "params": {
        "basic": true,
        "drive_compensation": false
      },
      "inputs": {
        "audio": {
          "signal": "noise",
          "amp": 0.5,
          "seed": 2,
          "stereo": true
        },
        "reset": {
          "trigger": [
            {
              "sample": 0,
              "value": "voice_on"
            }
          ]
        },
        "midi_cutoff": {
          "signal": "ramp",
          "from": 8.0,
          "to": 136.0
        },
        "resonance": {
          "signal": "ramp",
          "from": 0.0,
          "to": 1.0
        },
        "style": 0,
        "pass_blend": 2.0
      }
    },
