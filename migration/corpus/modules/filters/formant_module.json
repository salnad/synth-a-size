{
  "description": "FormantModule(\"filter_1\"): style switching between the two FormantFilter styles and VocalTract (whose processing is empty, so the shared output keeps the last block written), its own smoothed formant controls (set through params.controls: filter_1_formant_x/y 0..1, _transpose -12..12, _resonance 0.3..1, _spread -1..1) and per-voice reset of the active style. style input 0..2 (clamped).",
  "module": "formant_module",
  "cases": {
    "aoie_defaults": {
      "num_samples": 22050,
      "inputs": {
        "audio": { "signal": "saw", "freq_hz": 110.0, "amp": 0.5 },
        "reset": { "trigger": [ { "sample": 0, "value": "voice_on" } ] },
        "style": 0
      }
    },
    "aiuo_controls": {
      "params": {
        "controls": {
          "filter_1_formant_x": 0.2,
          "filter_1_formant_y": 0.9,
          "filter_1_formant_transpose": -7.0,
          "filter_1_formant_resonance": 1.0,
          "filter_1_formant_spread": 0.6
        }
      },
      "num_samples": 22050,
      "inputs": {
        "audio": { "signal": "noise", "amp": 0.5, "seed": 31, "stereo": true },
        "reset": { "trigger": [ { "sample": 0, "value": "voice_on" } ] },
        "style": 1
      }
    },
    "aoie_control_extremes": {
      "params": {
        "controls": {
          "filter_1_formant_x": 1.0,
          "filter_1_formant_y": 0.0,
          "filter_1_formant_transpose": 12.0,
          "filter_1_formant_resonance": 0.3,
          "filter_1_formant_spread": -1.0
        }
      },
      "num_samples": 22050,
      "inputs": {
        "audio": { "signal": "saw", "freq_hz": 196.0, "amp": 0.6 },
        "reset": { "trigger": [ { "sample": 0, "value": "voice_on" } ] },
        "style": 0
      }
    },
    "style_switching_with_resets": {
      "params": {
        "controls": {
          "filter_1_formant_x": 0.7,
          "filter_1_formant_y": 0.4,
          "filter_1_formant_transpose": 3.0,
          "filter_1_formant_spread": 0.25
        }
      },
      "num_samples": 22050,
      "inputs": {
        "audio": { "signal": "saw", "freq_hz": 110.0, "amp": 0.5 },
        "reset": {
          "trigger": [
            { "sample": 0, "value": "voice_on" },
            { "sample": 9000, "value": "voice_on", "voices": "1" }
          ]
        },
        "blend": 0.5,
        "style": { "signal": "ramp", "from": -1.0, "to": 3.5 }
      }
    }
  }
}
