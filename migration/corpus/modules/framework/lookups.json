{
  "description": "Memory, StereoMemory, OneDimLookup and OnePoleFilter probes. Ports: port/crates/dsp-core.",
  "num_samples": 4096,
  "cases": {
    "memory_ramp_delay": {
      "module": "memory_probe",
      "inputs": {
        "audio": {
          "signal": "noise",
          "stereo": true,
          "amp": 1.0,
          "seed": 1
        },
        "delay": {
          "signal": "ramp",
          "from": 2.0,
          "to": 1000.0
        }
      },
      "params": {
        "size": 1024
      }
    },
    "memory_modulated_delay": {
      "module": "memory_probe",
      "inputs": {
        "audio": {
          "signal": "sine",
          "freq_hz": 440,
          "amp": 0.8
        },
        "delay": {
          "signal": "sine",
          "freq_hz": 1.5,
          "amp": 200.0,
          "offset": 300.0
        }
      },
      "params": {
        "size": 700
      }
    },
