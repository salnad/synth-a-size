{
  "description": "ReverbModule through effect_module_harness.h (controls set once per block; 'on' toggles enable()). Cases named interim_* are short (0.25 s) versions of the parked full-length cases in pending/reverb_module.json, kept loaded while those wait on the no-fast-math proposal.",
  "module": "reverb_module",
  "cases": {
    "defaults_saw": {
      "num_samples": 132300,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        }
      }
    },
    "chorus_sweep": {
      "num_samples": 132300,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 165.0,
          "amp": 0.4
        },
        "reverb_chorus_amount": {
          "signal": "ramp",
          "from": 0.0,
          "to": 1.0
        },
        "reverb_chorus_frequency": {
          "signal": "ramp",
          "from": -8.0,
          "to": 3.0
        },
        "reverb_dry_wet": 0.7
      }
    },
    "enable_toggle": {
      "num_samples": 132300,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "on": {
          "signal": "square",
          "freq_hz": 1.0,
          "amp": 0.5,
          "offset": 0.5
        },
        "reverb_decay_time": 2.0,
        "reverb_dry_wet": 0.5
      }
    },
    "rate_96k": {
      "sample_rate": 96000,
      "block_size": 128,
      "num_samples": 192000,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "reverb_dry_wet": 0.5
      }
    },
    "oversampled_2x": {
      "oversample": 2,
      "block_size": 128,
      "num_samples": 88200,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "reverb_dry_wet": 0.5
      }
    },
    "interim_decay_and_size_sweep_short": {
      "num_samples": 11025,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "reverb_decay_time": {
          "signal": "ramp",
          "from": -6.0,
          "to": 6.0
        },
        "reverb_size": {
          "signal": "ramp",
          "from": 0.0,
          "to": 1.0
        },
        "reverb_dry_wet": 0.6
      }
    },
    "interim_filter_and_delay_sweep_short": {
      "num_samples": 11025,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "reverb_pre_low_cutoff": {
          "signal": "ramp",
          "from": 0.0,
          "to": 128.0
        },
        "reverb_pre_high_cutoff": {
          "signal": "ramp",
          "from": 128.0,
          "to": 0.0
        },
        "reverb_low_shelf_cutoff": {
          "signal": "ramp",
          "from": 0.0,
          "to": 128.0
        },
        "reverb_low_shelf_gain": {
          "signal": "ramp",
          "from": -6.0,
          "to": 0.0
        },
        "reverb_high_shelf_cutoff": {
          "signal": "ramp",
          "from": 128.0,
          "to": 0.0
        },
        "reverb_high_shelf_gain": {
          "signal": "ramp",
          "from": 0.0,
          "to": -6.0
        },
        "reverb_delay": {
          "signal": "ramp",
          "from": 0.0,
          "to": 0.3
        },
        "reverb_dry_wet": {
          "signal": "ramp",
          "from": 0.0,
          "to": 1.0
        }
      }
    },
    "interim_max_decay_short_tail": {
      "num_samples": 11025,
      "inputs": {
        "audio": {
          "signal": "impulse",
          "at": 300
        },
        "reverb_decay_time": 6.0,
        "reverb_size": 1.0,
        "reverb_dry_wet": 1.0
      }
    }
  }
}
