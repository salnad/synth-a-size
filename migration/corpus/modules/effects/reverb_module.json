{
  "description": "ReverbModule through effect_module_harness.h (controls set once per block; 'on' toggles enable()).",
  "module": "reverb_module",
  "cases": {
    "defaults_saw": {
      "num_samples": 132300,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        }
      }
    },
    "chorus_sweep": {
      "num_samples": 132300,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 165.0,
          "amp": 0.4
        },
        "reverb_chorus_amount": {
          "signal": "ramp",
          "from": 0.0,
          "to": 1.0
        },
        "reverb_chorus_frequency": {
          "signal": "ramp",
          "from": -8.0,
          "to": 3.0
        },
        "reverb_dry_wet": 0.7
      }
    },
    "enable_toggle": {
      "num_samples": 132300,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "on": {
          "signal": "square",
          "freq_hz": 1.0,
          "amp": 0.5,
          "offset": 0.5
        },
        "reverb_decay_time": 2.0,
        "reverb_dry_wet": 0.5
      }
    },
    "rate_96k": {
      "sample_rate": 96000,
      "block_size": 128,
      "num_samples": 192000,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "reverb_dry_wet": 0.5
      }
    },
    "oversampled_2x": {
      "oversample": 2,
      "block_size": 128,
      "num_samples": 88200,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "reverb_dry_wet": 0.5
      }
    }
  }
}
