        },
        "reverb_dry_wet": 0.6
      }
    },
    "filter_and_delay_sweep": {
      "num_samples": 132300,
      "inputs": {
        "audio": {
          "signal": "noise",
          "amp": 0.4,
          "stereo": true,
          "seed": 5
        },
        "reverb_pre_low_cutoff": {
          "signal": "ramp",
          "from": 0.0,
          "to": 128.0
        },
        "reverb_pre_high_cutoff": {
          "signal": "ramp",
          "from": 128.0,
          "to": 0.0
