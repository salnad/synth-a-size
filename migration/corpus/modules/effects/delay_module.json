        "delay_feedback": 0.7,
        "delay_dry_wet": 0.5
      }
    },
    "oversampled_2x": {
      "oversample": 2,
      "block_size": 128,
      "num_samples": 88200,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "delay_style": 3,
        "delay_feedback": 0.7,
        "delay_dry_wet": 0.5
      }
    },
    "long_tail_full_feedback": {
      "num_samples": 220500,
      "inputs": {
        "audio": {
          "signal": "impulse",
          "at": 100
        },
        "delay_style": 1,
        "delay_sync": 0,
        "delay_frequency": 2.0,
        "delay_aux_sync": 0,
        "delay_aux_frequency": 3.0,
        "delay_feedback": 1.0,
        "delay_dry_wet": 1.0
      }
    }
  }
