        "delay_tempo": 7,
        "delay_feedback": 0.6
      }
    },
    "rate_96k": {
      "sample_rate": 96000,
      "block_size": 128,
      "num_samples": 192000,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
