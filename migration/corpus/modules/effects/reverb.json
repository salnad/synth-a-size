{
  "description": "Reverb processor; inputs take the values ReverbModule's controls produce.",
  "module": "reverb",
  "cases": {
    "wet_sweep": {
      "num_samples": 88200,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 220.0,
          "amp": 0.4
        },
        "wet": {
          "signal": "ramp",
          "from": 0.0,
          "to": 1.0
        },
        "decay_time": 1.5
      }
    },
    "oversampled_2x": {
      "oversample": 2,
      "block_size": 128,
      "num_samples": 132300,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "decay_time": 2.0,
        "wet": 0.5
      }
    },
    "pre_delay_clamped": {
      "num_samples": 264600,
      "inputs": {
        "audio": {
          "signal": "square",
          "freq_hz": 3.0,
          "amp": 0.4
        },
        "delay": 4.5,
        "decay_time": 1.0,
        "wet": 0.9
      }
    }
  }
}
