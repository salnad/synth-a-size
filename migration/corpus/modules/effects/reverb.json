{
  "description": "Reverb processor; inputs take the values ReverbModule's controls produce. Cases named interim_* are short (0.25 s) versions of the parked full-length cases in pending/reverb.json, kept loaded while those wait on the no-fast-math proposal.",
  "module": "reverb",
  "cases": {
    "wet_sweep": {
      "num_samples": 88200,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 220.0,
          "amp": 0.4
        },
        "wet": {
          "signal": "ramp",
          "from": 0.0,
          "to": 1.0
        },
        "decay_time": 1.5
      }
    },
    "oversampled_2x": {
      "oversample": 2,
      "block_size": 128,
      "num_samples": 132300,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "decay_time": 2.0,
        "wet": 0.5
      }
    },
    "pre_delay_clamped": {
      "num_samples": 264600,
      "inputs": {
        "audio": {
          "signal": "square",
          "freq_hz": 3.0,
          "amp": 0.4
        },
        "delay": 4.5,
        "decay_time": 1.0,
        "wet": 0.9
      }
    },
    "interim_impulse_short_tail": {
      "num_samples": 11025,
      "inputs": {
        "audio": {
          "signal": "impulse",
          "at": 300
        },
        "decay_time": 4.0,
        "wet": 1.0,
        "size": 0.7
      }
    },
    "interim_decay_sweep_short": {
      "num_samples": 11025,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "decay_time": {
          "signal": "ramp",
          "from": 0.05,
          "to": 100.0
        },
        "wet": 0.5
      }
    },
    "interim_size_sweep_short": {
      "num_samples": 11025,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "size": {
          "signal": "ramp",
          "from": 0.0,
          "to": 1.0
        },
        "decay_time": 2.0,
        "wet": 0.6
      }
    },
    "interim_chorus_sweep_short": {
      "num_samples": 11025,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 220.0,
          "amp": 0.5
        },
        "chorus_amount": {
          "signal": "ramp",
          "from": 0.0,
          "to": 1.0
        },
        "chorus_frequency": {
          "signal": "ramp",
          "from": 0.0,
          "to": 16.0
        },
        "decay_time": 3.0,
        "wet": 0.7
      }
    },
    "interim_filter_sweeps_short": {
      "num_samples": 11025,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "pre_low_cutoff": {
          "signal": "ramp",
          "from": 0.0,
          "to": 130.0
        },
        "pre_high_cutoff": {
          "signal": "ramp",
          "from": 130.0,
          "to": 0.0
        },
        "low_cutoff": {
          "signal": "ramp",
          "from": 0.0,
          "to": 130.0
        },
        "high_cutoff": {
          "signal": "ramp",
          "from": 130.0,
          "to": 0.0
        },
        "low_gain": {
          "signal": "ramp",
          "from": -24.0,
          "to": 0.0
        },
        "high_gain": {
          "signal": "ramp",
          "from": 0.0,
          "to": -24.0
        },
        "decay_time": 2.5,
        "wet": 0.8
      }
    },
    "interim_pre_delay_sweep_short": {
      "num_samples": 11025,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "delay": {
          "signal": "ramp",
          "from": 0.0,
          "to": 0.3
        },
        "decay_time": 1.0,
        "wet": 0.9
      }
    },
    "interim_48k_short": {
      "sample_rate": 48000,
      "block_size": 128,
      "num_samples": 12000,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "decay_time": 3.0,
        "size": 0.9,
        "wet": 1.0
      }
    },
    "interim_192k_short": {
      "sample_rate": 192000,
      "block_size": 128,
      "num_samples": 48000,
      "inputs": {
        "audio": {
          "signal": "saw",
          "freq_hz": 110.0,
          "amp": 0.5
        },
        "decay_time": 1.5,
        "size": 1.0,
        "wet": 1.0
      }
    }
  }
}
