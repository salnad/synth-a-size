    { "name": "init_effects", "tab": "effects" },
    { "name": "init_matrix", "tab": "matrix" },
    { "name": "init_advanced", "tab": "advanced" },
    { "name": "filters_analog_comb", "tab": "voice", "preset": "migration/corpus/gui/presets/filters_analog_comb.vital" },
    { "name": "filters_formant_ladder", "tab": "voice", "preset": "migration/corpus/gui/presets/filters_formant_ladder.vital" },
    { "name": "filters_digital_diode", "tab": "voice", "preset": "migration/corpus/gui/presets/filters_digital_diode.vital" },
    { "name": "filters_dirty_phaser", "tab": "voice", "preset": "migration/corpus/gui/presets/filters_dirty_phaser.vital" },
    { "name": "all_effects", "tab": "effects", "preset": "migration/corpus/gui/presets/all_effects.vital" },
    { "name": "all_effects_bottom", "tab": "effects", "preset": "migration/corpus/gui/presets/all_effects.vital", "effects_scroll": 10000 },
    { "name": "sample_on", "tab": "voice", "preset": "migration/corpus/gui/presets/sample_on.vital" },
    { "name": "modulations", "tab": "voice", "preset": "migration/corpus/gui/presets/modulations.vital", "seconds": 0.05, "animate": true },
    { "name": "modulations_many", "tab": "voice", "preset": "migration/corpus/gui/presets/modulations_many.vital", "seconds": 0.05, "animate": true },
